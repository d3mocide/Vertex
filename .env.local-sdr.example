# Full Local SDR Mode (run OP25, Icecast, and SDR services in this stack)
# Usage:
#   1) Copy to .env.local-sdr and fill values
#   2) Run: docker compose --env-file .env.local-sdr --profile sdr up -d

# Compose should inject the same file into backend/poller
OUTPOST_ENV_FILE=.env.local-sdr

# Core DB
POSTGRES_DB=outpost
POSTGRES_USER=outpost
POSTGRES_PASSWORD=changeme

# Frontend
FRONTEND_PORT=80
VITE_STREAM_URL=/stream/radio.mp3
RADIO_STREAM_URL=/stream/radio.mp3

# Frontend dev proxy targets (local profile services)
VITE_PROXY_OP25_TARGET=http://op25:8080/
VITE_PROXY_ICECAST_TARGET=http://icecast:8000/

# Poller OP25 source (local compose service)
OP25_HOST=op25
OP25_PORT=8080

# SDR tuning
ADSB_SDR_SERIAL=adsb001
P25_SAMPLE_RATE=2400000
P25_PPM=0
P25_GAIN=40

# Region
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_ALT=100ft
REGION_NAME=Tualatin Valley
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# Weather / alerts
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ006
NWS_ALERT_ZONES=ORZ006,ORZ005,ORZ007

# External data API keys (optional)
ODOT_API_KEY=
AIRNOW_API_KEY=
AISSTREAM_API_KEY=

# ADS-B source (leave blank to use local ultrafeeder profile)
ULTRAFEEDER_URL=
ULTRAFEEDER_HOST=
ULTRAFEEDER_PORT=80

# Local AIS-catcher (optional)
AIS_CATCHER_HOST=
AIS_CATCHER_PORT=8100

# MeshCore bridge
MESHCORE_MODE=network
MESHCORE_HOST=meshcore
MESHCORE_PORT=5000
MESHCORE_BAUD=115200
MESHCORE_BRIDGE_HOST=meshcore
MESHCORE_BRIDGE_PORT=7001

# Icecast credentials (used by local profile services)
ICECAST_HOSTNAME=localhost
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_RELAY_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=changeme

LOG_LEVEL=INFO
