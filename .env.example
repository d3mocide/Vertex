# Copy to .env and fill in your values

# --- Database ---
POSTGRES_DB=civicgrid
POSTGRES_USER=civicgrid
POSTGRES_PASSWORD=changeme

# --- Frontend port (default 80) ---
FRONTEND_PORT=80

# --- Region: Tualatin/Portland Metro ---
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_NAME=Tualatin Valley

# Bounding box for API queries
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# --- NWS Weather ---
# Stations near Tualatin: KHIO (Portland-Hillsboro), KUAO (Aurora State)
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
# NWS forecast zone for Washington County OR
NWS_ZONE=ORZ006

# --- ODOT TripCheck (no key needed) ---
ODOT_INCIDENTS_URL=https://tripcheck.com/Scripts/rss.asp?CMS=true&RSS=TripCheck

# --- Local SDR sources (leave empty if hardware not present) ---
# Ultrafeeder readsb JSON endpoint (e.g. 192.168.1.50)
ULTRAFEEDER_HOST=
ULTRAFEEDER_PORT=30047

# AIS-catcher WebSocket endpoint
AIS_CATCHER_HOST=
AIS_CATCHER_PORT=8100

# --- Public fallback APIs ---
# AISstream.io free-tier API key (https://aisstream.io — free, no CC required)
AISSTREAM_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
