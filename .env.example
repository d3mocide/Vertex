# Vertex — Environment Configuration Template
# Copy this to .env (or .env.remote) and fill in your values.
# Run Prod: docker compose up -d
# Run Dev: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d

# ── 1. CORE INFRASTRUCTURE ───────────────────────────────────────────────────

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=vertex
POSTGRES_USER=vertex
POSTGRES_PASSWORD=changeme

# Redis (State Cache)
REDIS_URL=redis://redis:6379

# Frontend Port (Default 80)
FRONTEND_PORT=80

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── 2. REGIONAL SETTINGS ──────────────────────────────────────────────────────

# Map Center & Region Name
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_ALT=100ft
REGION_NAME=Tualatin Valley

# Data Bounding Box (Min/Max Lat/Lon)
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# ── 3. EXTERNAL DATA FEEDS ────────────────────────────────────────────────────

# NWS Weather (No key needed)
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ006
NWS_ALERT_ZONES=ORZ006,ORZ005,ORZ007

# ODOT TripCheck (Free key: developer.odot.state.or.us)
ODOT_API_KEY=
# AirNow AQI (Free key: airnowapi.org)
AIRNOW_API_KEY=
# AISstream.io (Free key: aisstream.io)
AISSTREAM_API_KEY=
# Local AIS-catcher (Optional URL, e.g. ws://localhost:8100)
AIS_CATCHER_URL=

# ── 4. REGIONAL FEEDS & ALERTS ────────────────────────────────────────────────

# Traffic flow corridors — comma-separated highway name fragments
TRAFFIC_FLOW_CORRIDORS=I-5,99W,Pacific Highway

# Regional alert feeds (Set *_ENABLED=false to disable)
FLASHALERT_ENABLED=true
FLASHALERT_URL=http://www.flashalertnewswire.net/IIN/reportsX/flashnews_xml_emergency.php
TVFR_ENABLED=true
TVFR_RSS_URL=https://www.tvfr.com/RSSFeed.aspx?ModID=63&CID=Emergency-Alert-3

# ── 5. TACTICAL RADIO & SDR ──────────────────────────────────────────────────

# Radio Stream Path (Browser mount point, e.g. /stream/radio.mp3)
RADIO_STREAM_URL=/stream/radio.mp3

# Remote Icecast Server (Required for audio playback in dev/remote mode)
# If running local SDR profile, set to http://icecast:8000
ICECAST_URL=http://localhost:8000

# Remote OP25 Terminal (Required for radio metadata)
# If running local SDR profile, set to http://op25:8080
OP25_URL=http://localhost:8080

# Remote ADS-B Source (Full aircraft.json URL)
# If running local SDR profile, set to http://ultrafeeder/data/aircraft.json
ADSB_URL=

# MeshCore Bridge (Optional URL, e.g. ws://localhost:7001)
MESHCORE_URL=

# ── 6. AI & ANALYTICS (OPTIONAL) ─────────────────────────────────────────────

# LiteLLM-compatible model (e.g. anthropic/claude-3-haiku, ollama/llama3)
SUMMARY_LLM_MODEL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_API_BASE=

# ── 7. SECURITY ───────────────────────────────────────────────────────────────

# Enable Authentication (Set to true to require login)
AUTH_ENABLED=false
# Secret key for JWT signing (Generate: openssl rand -hex 32)
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=24
