# Copy to .env and fill in your values

# ── Database ─────────────────────────────────────────
POSTGRES_DB=vertex
POSTGRES_USER=vertex
POSTGRES_PASSWORD=changeme

# ── Frontend port (default 80) ────────────────────────
FRONTEND_PORT=80

# ── Region: Tualatin/Portland Metro ──────────────────
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_ALT=100ft
REGION_NAME=Tualatin Valley

# Bounding box for external API queries (Portland metro)
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# ── NWS Weather (no key needed) ──────────────────────
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ006
# Multi-county NWS alert zones (Washington=ORZ006, Multnomah=ORZ005, Clackamas=ORZ007)
NWS_ALERT_ZONES=ORZ006,ORZ005,ORZ007


# ── ODOT TripCheck Traffic (free API key) ────────────────────────
# Get a free key at: https://developer.odot.state.or.us
# Subscribe to "TripCheck API" product — no cost, immediate activation.
ODOT_API_KEY=

# Traffic flow corridors — comma-separated highway name fragments to include.
# Override if deploying outside the Portland/Tualatin metro area.
TRAFFIC_FLOW_CORRIDORS=I-5,99W,Pacific Highway

# ── Regional alert feeds ──────────────────────────────
# Set *_ENABLED=false to disable a source. Override URLs for non-Portland deployments.
FLASHALERT_ENABLED=true
FLASHALERT_URL=http://www.flashalertnewswire.net/IIN/reportsX/flashnews_xml_emergency.php
TVFR_ENABLED=true
TVFR_RSS_URL=https://www.tvfr.com/RSSFeed.aspx?ModID=63&CID=Emergency-Alert-3

# ── Public fallback APIs ──────────────────────────────
# EPA AirNow AQI API (https://www.airnowapi.org)
AIRNOW_API_KEY=

# AISstream.io free-tier key (https://aisstream.io)
AISSTREAM_API_KEY=

# ── AI Situational Summary (optional) ────────────────
# Anthropic API key — enables the 5-minute AI summary poller (claude-haiku-4-5).
# Leave blank to disable. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── SDR Hardware (docker compose --profile sdr) ───────

# ADS-B — RTL-SDR serial number (set with: rtl_eeprom -d 0 -s adsb001)
ADSB_SDR_SERIAL=adsb001

# P25 / OP25 — RTL-SDR serial number for the P25 dongle
P25_SAMPLE_RATE=2400000
P25_PPM=0
P25_GAIN=40

# Local ADS-B — point at an existing UltraFeeder on the network
# Option A (recommended): set ULTRAFEEDER_URL to the full aircraft.json URL
#   e.g. ULTRAFEEDER_URL=http://192.168.1.50/data/aircraft.json
#        ULTRAFEEDER_URL=http://raspberrypi.local/data/aircraft.json
# Option B: set ULTRAFEEDER_HOST + ULTRAFEEDER_PORT separately
# Leave blank to fall back to OpenSky public API (rate-limited).
ULTRAFEEDER_URL=
ULTRAFEEDER_HOST=
ULTRAFEEDER_PORT=80

# OP25 terminal endpoint (set to "op25" when running in compose)
OP25_HOST=op25
OP25_PORT=8080

# Frontend stream path (must match Icecast mount; e.g. /stream/op25)
VITE_STREAM_URL=/stream/radio.mp3

# Icecast stream server
ICECAST_HOSTNAME=localhost
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_RELAY_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=changeme

# Local AIS-catcher (optional, separate from the main stack)
AIS_CATCHER_HOST=
AIS_CATCHER_PORT=8100

# MeshCore bridge
# mode: "serial" (USB device) or "network" (existing hub TCP)
MESHCORE_MODE=network
MESHCORE_HOST=meshcore
MESHCORE_PORT=5000
# For serial mode — path on the Pi host:
# MESHCORE_SERIAL_DEVICE=/dev/ttyUSB2
MESHCORE_BAUD=115200

# Poller connects to bridge WebSocket
MESHCORE_BRIDGE_HOST=meshcore
MESHCORE_BRIDGE_PORT=7001

# ── Auth proxy (docker compose --profile auth) ───────
# Generate a bcrypt hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
CADDY_PORT=8080
CADDY_BASICAUTH_USER=admin
CADDY_BASICAUTH_HASH=

# ── Remote access tunnel (docker compose --profile remote) ──
# Paste your Cloudflare tunnel token from dash.cloudflare.com > Zero Trust > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
