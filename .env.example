# Vertex — Environment Configuration Template
# Copy this to .env and fill in your values.
# Run: docker compose up -d
#
# Streams, news feeds, ADS-B/AIS/P25/MeshCore endpoints:
#   → config/sources.example.yml  (copy to config/sources.yml)

# ── 1. CORE INFRASTRUCTURE ───────────────────────────────────────────────────

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=vertex
POSTGRES_USER=vertex
POSTGRES_PASSWORD=replace-with-a-long-random-database-secret
REDIS_PASSWORD=change-this-to-a-long-random-secret

# Redis (State Cache)
REDIS_URL=redis://:change-this-to-a-long-random-secret@redis:6379

# Frontend Port (Default 80)
FRONTEND_PORT=80

# MQTT broker is opt-in and loopback-only by default. Set MQTT_BIND_ADDRESS to a specific LAN IP only when needed.
# Point RTL_433, Meshtastic, AIS-catcher, and other IoT devices at this Pi's LAN IP on this port.
MQTT_PORT=1883

# MQTT source credentials — only required when auth_enabled=true in sources.yml.
# Variable name format: MQTT_{UPPER_SNAKE_SOURCE_NAME}_USERNAME / _PASSWORD
# Example for a source named "Remote Broker":
# MQTT_REMOTE_BROKER_USERNAME=
# MQTT_REMOTE_BROKER_PASSWORD=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── 2. REGIONAL SETTINGS ──────────────────────────────────────────────────────

# Map Center & Region Name
# Setting REGION_LAT / REGION_LON pins the region to this file. Leave them out (and
# choose the region in the app) to store it in the database instead. The frontend
# reads the region at runtime — no rebuild is needed after changing it.
# On a fresh install the poller waits for the setup wizard; SETUP_GATE=false skips that wait.
# SETUP_GATE=true
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_NAME=Tualatin Valley

# Data Bounding Box (Min/Max Lat/Lon)
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# ── 3. EXTERNAL DATA FEEDS ────────────────────────────────────────────────────

# NWS Weather (No key needed — find zone codes at weather.gov/pimar/PubZone)
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ109
# Forecast zones + counties (ORC/WAC) + fire-weather zones: county- and fire-zone
# alerts (flood warnings, Red Flag Warnings) are not issued to forecast zones.
# Find yours: https://api.weather.gov/points/<lat>,<lon> (forecastZone, county, fireWeatherZone).
# NWS renumbered Oregon zones on 2026-04-16 (ORZ005-007 no longer exist).
NWS_ALERT_ZONES=ORZ108,ORZ109,ORZ111,ORZ112,ORZ115,WAZ204,WAZ205,WAZ206,WAZ207,ORC067,ORC051,ORC005,WAC011,ORZ684,WAZ633
# NWS Weather Forecast Office id for forecaster products — AFD, HWO, LSR
# (Portland = PQR, Seattle = SEW, Medford = MFR)
NWS_OFFICE=PQR
# Climate station id for daily climate reports — CF6 (Portland = PDX)
NWS_CLIMATE_STATION=PDX

# ODOT TripCheck (Free key: developer.odot.state.or.us)
ODOT_API_KEY=

# WSDOT Traveler API access code: https://www.wsdot.wa.gov/traffic/api/
WSDOT_API_KEY=
# AirNow AQI (Free key: airnowapi.org)
# NASA FIRMS satellite fire hotspots (free key: firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

AIRNOW_API_KEY=
# AISstream.io cloud fallback (Free key: aisstream.io — local AIS via sources.yml)
AISSTREAM_API_KEY=

# Wildfire relevance controls
# Local fires inside the bbox or this radius remain alertable.
FIRE_ALERT_RADIUS_KM=150
# Local fires are suppressed if they haven't been updated in this many hours.
FIRE_ALERT_RECENT_HOURS=720
# Regional wildfire sources are retained for smoke awareness.
FIRE_REGIONAL_RADIUS_KM=1200
# Older regional fires are suppressed to keep the watch list current.
# EONET keeps events "open" long after activity stops; 72h keeps only fires
# with recent updates (likely smoke sources).
FIRE_REGIONAL_RECENT_HOURS=72
# NIFC fire perimeters not updated within this many days are not fetched
# (year-to-date holds thousands of long-out fires).
NIFC_PERIMETER_MAX_AGE_DAYS=30

# APRS-IS fallback credentials/filter (used when APRS source is enabled)
APRS_CALLSIGN=N0CALL
APRS_PASSCODE=-1
APRS_FILTER_RADIUS_KM=80

# MeshCore node gating — a pyMC-Repeater advertises every node it has ever
# heard, which can span an entire regional mesh. When enabled (default),
# nodes whose advertised position falls outside the configured region
# bbox(es) are dropped, like the ADS-B/AIS bbox gating. The pad widens the
# bbox by N degrees so nearby ridge-top repeaters just outside the box are
# still kept. Nodes with no advertised position always pass.
MESH_BBOX_FILTER=true
MESH_BBOX_PAD_DEG=0.25

# ADS-B ingest strategy
# Mode A — BEAST TCP (set ADSB_ENABLE_BEAST=true + configure sources.yml)
# Mode B — ultrafeeder HTTP only (BEAST disabled, sources.yml has adsb entries)
# Mode C — BEAST primary, automatic HTTP fallback when BEAST goes stale
#           (BEAST enabled + sources.yml has adsb entries — no extra flag needed)
# Mode D — hybrid: local source + OpenSky supplement (see ADSB_OPENSKY_SUPPLEMENT below)
ADSB_ENABLE_BEAST=false
ADSB_BEAST_HOST=localhost
ADSB_BEAST_PORT=30005
ADSB_BEAST_RECONNECT_INITIAL_SECONDS=1
ADSB_BEAST_RECONNECT_MAX_SECONDS=30
# Seconds without a BEAST frame before HTTP fallback activates (Mode C)
ADSB_BEAST_STALE_THRESHOLD_SECONDS=30
ADSB_PUBLISH_ONLY_CHANGES=true
# Seconds since the last resolved CPR fix before a BEAST track is flagged stale
ADSB_POSITION_STALE_SECONDS=10
# Max seconds a stale position is dead-reckoned forward along the last known
# velocity (keeps icons moving through short signal gaps; 0 disables)
ADSB_DEAD_RECKON_MAX_SECONDS=60

# Mode D — OpenSky supplement alongside local sources
# Enabled by default. Local sources (beast/ultrafeeder) remain primary; OpenSky
# fills in aircraft not seen locally within the effective handover window —
# max(ADSB_OPENSKY_STALE_THRESHOLD, poll interval), capped at 90s. Supplemented
# tracks render dimmed on the map. The 30s cadence below assumes a free OpenSky
# account with an API client (set ADSB_OPENSKY_CLIENT_ID / _SECRET) and gives a smooth
# ~30s handover when BEAST drops into a signal gap.
#
# Rate limit guidance:
#   OpenSky only accepts OAuth2 now (Basic username/password no longer works):
#   create an API client on your OpenSky account page.
#   Registered: 4000 credits/day; with an active feeder: 8000/day. Our bbox costs 1 credit/poll,
#     so 120s (~720/day) fits; OpenSky is only a gap-filler behind the community feed.
#   Anonymous (no client): 400 credits/day — the poller floors the interval at 220s automatically.
ADSB_OPENSKY_SUPPLEMENT=true
ADSB_OPENSKY_INTERVAL=120
ADSB_OPENSKY_STALE_THRESHOLD=25
ADSB_OPENSKY_RECORD_OBSERVATIONS=true
ADSB_OPENSKY_CLIENT_ID=
ADSB_OPENSKY_CLIENT_SECRET=

# Observation persistence mode:
#   record    -> write observation history rows (default)
#   live_only -> skip observation inserts, keep live entity/geofence behavior
ADSB_HISTORY_MODE=record
ADSB_ENRICHMENT_CACHE_DIR=/data
ADSB_AIRCRAFT_DB_PATH=/data/aircraft_db.csv.gz
ADSB_AIRPORTS_DB_PATH=/data/airports.csv
ADSB_AIRLINES_DB_PATH=/data/airlines.dat
ADSB_NAVAIDS_DB_PATH=/data/navaids.csv

# Traffic flow corridors — comma-separated highway name fragments
TRAFFIC_FLOW_CORRIDORS=I-5,I-205,I-84,I-405,US26,OR-217

# ── 4. TAK / CoT (BIDIRECTIONAL) ─────────────────────────────────────────────

# TAK server host and port — shared by both emitter and receiver.
# Standard TAK Server: port 8087  |  OpenTAK Server (OTS): port 8088
# Leave COT_TAKSERVER_HOST blank to use UDP multicast instead of a TAK server.
COT_ENABLED=false
COT_MULTICAST_ADDR=239.2.3.1
COT_MULTICAST_PORT=6969
COT_STALE_SECONDS=60
COT_TAKSERVER_HOST=
COT_TAKSERVER_PORT=8087
# Entity types to emit — comma-separated, empty = all types.
# Available types:
#   aircraft      ADS-B transponder tracks (Beast / OpenSky)
#   vessel        AIS vessel positions
#   aprs          APRS packet radio stations
#   mesh_node     Meshtastic / MeshCore nodes
#   train         Amtrak + GTFS-RT light rail / commuter rail
#   fire_incident Wildfire incident data (NIFC / fire.gov)
#   stream_gauge  USGS stream gauge readings
#   rf_sensor     RTL-433 RF sensor devices
#   tak_client    TAK field operators received from OTS
# Examples:
#   COT_ENTITY_TYPES=aircraft,vessel
#   COT_ENTITY_TYPES=aircraft,vessel,fire_incident
#   COT_ENTITY_TYPES=aircraft,vessel,fire_incident,aprs,mesh_node
COT_ENTITY_TYPES=

# Enable receive direction (TAK server → Vertex).
# Field operator positions appear as tak_client entities; TAK markers as annotations.
COT_RECEIVE_ENABLED=false

# ── 5. FRONTEND BUILD ─────────────────────────────────────────────────────────

# Radar overlay layer ID (see MapLibre/RainViewer layer list)
VITE_RADAR_LAYER=RTX-N0B-0
# Fallback radar layer shown at low zoom levels
VITE_RADAR_FALLBACK_LAYER=radar
VITE_RADAR_FALLBACK_MAX_ZOOM=6
# Trail history radius shown on the map (km)
VITE_OBSERVATION_RANGE_KM=50
# Hours since a mesh node's last advert before it is shown as STALE / OFFLINE on the map.
# MeshCore nodes advert only every 24–48 h, so keep this above one advert cycle.
VITE_MESH_NODE_STALE_HOURS=72
# Keep false for normal operation. True enables cleaner map snapshots but costs render performance.
VITE_PRESERVE_DRAWING_BUFFER=false

# ── 6. TRIMET GTFS-RT (OPTIONAL) ─────────────────────────────────────────────
# TriMet buses, MAX light rail, WES commuter rail and Portland Streetcar positions.
# Free AppID at: https://developer.trimet.org/
# route_types: 0=Tram/Streetcar/MAX, 1=Subway/Metro, 2=Rail/WES, 3=Bus
TRIMET_GTFS_ENABLED=true
TRIMET_APP_ID=
TRIMET_ROUTE_TYPES=0,1,2,3
TRIMET_POLL_INTERVAL=15
# URL overrides — defaults point to TriMet's official endpoints (rarely needed):
# TRIMET_GTFS_STATIC_URL=https://developer.trimet.org/schedule/gtfs.zip
# TRIMET_GTFS_RT_URL=https://developer.trimet.org/ws/gtfs/VehiclePositions

# ── 7. P25 AUDIO / Transcription / Alert Feeds (OPTIONAL) ────────────────────────────
# P25 audio archiving — records per-call audio segments from RadioStream sources.
P25_AUDIO_ENABLED=true
P25_AUDIO_DIR=/data/audio
P25_AUDIO_RETENTION_DAYS=7
P25_AUDIO_DELAY_SECONDS=0.5
# Record calls from OP25's audio websocket (multi_rx destination ws://host:9000) —
# lossless and without the Icecast delay. Several receivers: comma-separated, in
# multi_rx channel order (e.g. ws://host:9000,ws://host:9001). Blank = radio stream.
P25_AUDIO_WS_URL=

# Whisper P25 transcription (runs in the `transcription` container).
# Model sizes vs RAM:  tiny ~150 MB | base ~300 MB | small ~600 MB | medium ~1.5 GB
# int8 is the fastest CPU compute type with negligible quality loss on radio audio.
# Set WHISPER_LANGUAGE=auto to let Whisper detect the language per call.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# CPU threads for Whisper inference. Keep at 1 on small hosts (2-core VPS /
# Pi) so transcription bursts can't starve the poller and API; raise if you
# have spare cores.
WHISPER_CPU_THREADS=1

# Remote STT — offload transcription to an external OpenAI-compatible
# /audio/transcriptions endpoint (a local AI node, a LiteLLM proxy router, or
# a hosted provider) instead of running faster-whisper on this host's CPU.
# Uses the LiteLLM SDK (in the transcription container), so the model string
# follows the "<provider>/<model>" convention. Examples:
#   WHISPER_REMOTE_MODEL=openai/whisper-1        (local node/proxy exposing an
#                                                  OpenAI-compatible STT API —
#                                                  set WHISPER_REMOTE_API_BASE
#                                                  to its URL, e.g.
#                                                  http://ai-node:8000/v1)
#   WHISPER_REMOTE_MODEL=groq/whisper-large-v3    (hosted; requires
#                                                  WHISPER_REMOTE_API_KEY)
# Leave WHISPER_REMOTE_MODEL blank to transcribe locally with the WHISPER_*
# settings above (default — no external calls, matches Vertex's local-first
# design).
WHISPER_REMOTE_MODEL=
WHISPER_REMOTE_API_BASE=
WHISPER_REMOTE_API_KEY=

# FlashAlert & TVFR feed fallbacks (RSS/REST URL overrides)
FLASHALERT_ENABLED=false
FLASHALERT_URL=
TVFR_ENABLED=false
TVFR_RSS_URL=

# ── 8. AI & ANALYTICS (OPTIONAL) ─────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions server (LocalAI, llama.cpp, vLLM,
# Ollama, LM Studio, OpenAI). API_BASE is the server root or its /v1 URL,
# e.g. http://ai-node:8080 or http://host:11434/v1. A leading "openai/" on
# the model name is accepted and stripped.
SUMMARY_LLM_MODEL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_API_BASE=
# Output token budget for the summary completion. Reasoning/"thinking"
# models spend part of this on an internal reasoning trace before writing
# the final answer — raise this (e.g. 8192+) if the briefing comes back
# empty or truncated with such a model.
SUMMARY_LLM_MAX_TOKENS=4096
# The briefing regenerates every SUMMARY_INTERVAL_MINUTES and covers the last
# SUMMARY_WINDOW_HOURS (events, radio, news, NWS products, …). UI-triggered
# refreshes and retries after a failure are limited to one per SUMMARY_MIN_REGEN_S.
SUMMARY_INTERVAL_MINUTES=60
SUMMARY_WINDOW_HOURS=24
SUMMARY_MIN_REGEN_S=600
SUMMARY_LLM_TIMEOUT_S=600
# Character budget for the data context (~4 chars/token). The model's context
# window must fit this + ~1k tokens of instructions + the reasoning trace +
# the answer; for a reasoning model allow at least 16k tokens of context.
# Lowest-priority sections (news, then radio transcripts) are trimmed first.
SUMMARY_CONTEXT_MAX_CHARS=24000
SUMMARY_BASELINE_DAYS=7
# Hours of P25 transcripts mined for structured radio incidents.
RADIO_INCIDENTS_WINDOW_HOURS=24
# Self-hosted Nominatim geocoder (infra/nominatim/README.md), e.g. http://nominatim-host:8088
# Blank disables geocoding of radio incident addresses.
GEOCODER_URL=
# State of the imported Nominatim extract (used in structured searches).
GEOCODER_STATE=Oregon
# Geofence UI: ZIP-code boundaries come from the US Census TIGERweb service
# (the searched ZIP is sent to census.gov). false keeps lookups fully local.
BOUNDARY_ZIP_LOOKUP_ENABLED=true
SUMMARY_HISTORY_LEN=24
# Optional sampling / reasoning controls (blank = provider default).
SUMMARY_LLM_TEMPERATURE=
SUMMARY_LLM_REASONING_EFFORT=
# Raw JSON merged into the request body for server-specific knobs, e.g.
# {"chat_template_kwargs": {"enable_thinking": true}}
SUMMARY_LLM_EXTRA_BODY=
# IANA timezone for local times in the briefing.
REGION_TIMEZONE=America/Los_Angeles

# Anomaly detection — statistical baseline monitoring
ANOMALY_ENABLED=true
ANOMALY_WINDOW_MINUTES=60
ANOMALY_SIGMA_THRESHOLD=2.5

# Network listeners bind to loopback by default. Set a specific LAN IP deliberately.
FRONTEND_BIND_ADDRESS=127.0.0.1
TILESERVER_BIND_ADDRESS=127.0.0.1

# ── 9. SECURITY ─────────────────────────────────────────────────────────────
# Enable Authentication (Set to true to require login, false allows viewer access only)
AUTH_ENABLED=false
# Secret key for JWT signing (Generate: openssl rand -hex 32)
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=8
# Set true when using the TLS compose overlay. The overlay enables it automatically.
AUTH_COOKIE_SECURE=false
# JSON Host header allowlist; add the LAN IP or DNS name you browse to.
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Exact hostnames/IPs allowed for intentional private-network integrations.
PRIVATE_HOST_ALLOWLIST=[]
# Deprecated and ignored; retained so older .env files fail safely.
ALLOW_PRIVATE_IPS=false
TRUSTED_PROXIES=["127.0.0.1/32","::1/128","172.16.0.0/12"]

# CORS — JSON array of allowed origins (e.g. ["http://192.168.1.100","https://vertex.local"])
CORS_ORIGINS=["http://localhost:3000","http://localhost"]
CORS_ALLOW_CREDENTIALS=false

# TLS — used with: docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# Generate self-signed cert: openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem -out certs/cert.pem -days 365 -nodes -subj "/CN=vertex"
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# Optional integrations (off by default): ACARS decoder feed, MQTT broker sources.
ACARS_ENABLED=false
MQTT_ENABLED=false
# Opt-in bundled broker. Use a long random password; bind a LAN IP only when needed.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_USERNAME=
MQTT_PASSWORD=
# Used by the poller for each bundled-broker source in sources.yml.
MQTT_RTL_433_SENSORS_USERNAME=
MQTT_RTL_433_SENSORS_PASSWORD=
MQTT_MESHTASTIC_USERNAME=
MQTT_MESHTASTIC_PASSWORD=
MQTT_AIS_CATCHER_MQTT_USERNAME=
MQTT_AIS_CATCHER_MQTT_PASSWORD=
MESHCORE_API_KEY=

# Advisory bar / sidebar: "nearby" radius in km from REGION_LAT/LON (8 km ~ 5 mi)
# ADVISORY_RADIUS_KM=8.0

# Sound Transit / Puget Sound OneBusAway developer key (separate from WSDOT).
# Request through the official Sound Transit Open Transit Data page.
SOUNDTRANSIT_API_KEY=
