# Vertex — Environment Configuration Template
# Copy this to .env and fill in your values.
# Run: docker compose up -d
#
# Streams, news feeds, ADS-B/AIS/P25/MeshCore endpoints:
#   → config/sources.example.yml  (copy to config/sources.yml)

# ── 1. CORE INFRASTRUCTURE ───────────────────────────────────────────────────

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=vertex
POSTGRES_USER=vertex
POSTGRES_PASSWORD=changeme

# Redis (State Cache)
REDIS_URL=redis://redis:6379

# Frontend Port (Default 80)
FRONTEND_PORT=80

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── 2. REGIONAL SETTINGS ──────────────────────────────────────────────────────

# Map Center & Region Name
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_NAME=Tualatin Valley

# Data Bounding Box (Min/Max Lat/Lon)
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# ── 3. EXTERNAL DATA FEEDS ────────────────────────────────────────────────────

# NWS Weather (No key needed — find zone codes at weather.gov/pimar/PubZone)
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ006
NWS_ALERT_ZONES=ORZ006,ORZ005,ORZ007,ORZ108,ORZ109,ORZ111,ORZ112,WAZ204,WAZ205,WAZ206,WAZ207
# Local forecast office code (e.g. PDX or PQR)
NWS_OFFICE=PDX

# Weather Underground PWS (Free key: wunderground.com/member/api-keys)
WUNDERGROUND_API_KEY=
WUNDERGROUND_STATION_ID=

# ODOT TripCheck (Free key: developer.odot.state.or.us)
ODOT_API_KEY=
# AirNow AQI (Free key: airnowapi.org)
AIRNOW_API_KEY=
# AISstream.io cloud fallback (Free key: aisstream.io — local AIS via sources.yml)
AISSTREAM_API_KEY=

# Wildfire relevance controls
# Local fires inside the bbox or this radius remain alertable.
FIRE_ALERT_RADIUS_KM=150
# Local fires are suppressed if they haven't been updated in this many hours.
FIRE_ALERT_RECENT_HOURS=720
# Regional wildfire sources are retained for smoke awareness.
FIRE_REGIONAL_RADIUS_KM=1200
# Older regional fires are suppressed to keep the watch list current.
FIRE_REGIONAL_RECENT_HOURS=336

# APRS-IS fallback credentials/filter (used when APRS source is enabled)
APRS_CALLSIGN=N0CALL
APRS_PASSCODE=-1
APRS_FILTER_RADIUS_KM=80

# ADS-B ingest strategy
# Mode A — BEAST TCP (set ADSB_ENABLE_BEAST=true + configure sources.yml)
# Mode B — ultrafeeder HTTP only (BEAST disabled, sources.yml has adsb entries)
# Mode C — BEAST primary, automatic HTTP fallback when BEAST goes stale
#           (BEAST enabled + sources.yml has adsb entries — no extra flag needed)
# Mode D — hybrid: local source + OpenSky supplement (see ADSB_OPENSKY_SUPPLEMENT below)
ADSB_ENABLE_BEAST=false
ADSB_BEAST_HOST=localhost
ADSB_BEAST_PORT=30005
ADSB_BEAST_RECONNECT_INITIAL_SECONDS=1
ADSB_BEAST_RECONNECT_MAX_SECONDS=30
# Seconds without a BEAST frame before HTTP fallback activates (Mode C)
ADSB_BEAST_STALE_THRESHOLD_SECONDS=30
ADSB_PUBLISH_ONLY_CHANGES=true

# Mode D — OpenSky supplement alongside local sources
# Set ADSB_OPENSKY_SUPPLEMENT=true to enable. Local sources (beast/ultrafeeder)
# remain primary; OpenSky fills in aircraft not seen locally within
# ADSB_OPENSKY_STALE_THRESHOLD seconds.
#
# Rate limit guidance:
#   Anonymous (no credentials): keep ADSB_OPENSKY_INTERVAL >= 220 (~400 req/day)
#   Authenticated (free account): 30s is safe (~2880 req/day vs 4000 limit)
#   Register free at https://opensky-network.org
ADSB_OPENSKY_SUPPLEMENT=false
ADSB_OPENSKY_INTERVAL=240
ADSB_OPENSKY_STALE_THRESHOLD=15
ADSB_OPENSKY_RECORD_OBSERVATIONS=true
ADSB_OPENSKY_USERNAME=
ADSB_OPENSKY_PASSWORD=

# Observation persistence mode:
#   record    -> write observation history rows (default)
#   live_only -> skip observation inserts, keep live entity/geofence behavior
ADSB_HISTORY_MODE=record
ADSB_ENRICHMENT_CACHE_DIR=/data
ADSB_AIRCRAFT_DB_PATH=/data/aircraft_db.csv.gz
ADSB_AIRPORTS_DB_PATH=/data/airports.csv
ADSB_AIRLINES_DB_PATH=/data/airlines.dat
ADSB_NAVAIDS_DB_PATH=/data/navaids.csv

# Traffic flow corridors — comma-separated highway name fragments
TRAFFIC_FLOW_CORRIDORS=I-5,99W,Pacific Highway

# ── 4. TAK / CoT (BIDIRECTIONAL) ─────────────────────────────────────────────

# Outbound — broadcast Vertex entity positions and map annotations to ATAK/WinTAK
# via UDP multicast (default) or directly to a TAK server via unicast.
COT_ENABLED=false
COT_MULTICAST_ADDR=239.2.3.1
COT_MULTICAST_PORT=6969
COT_STALE_SECONDS=60
# Optional unicast to a TAK server — overrides multicast when set
COT_TAKSERVER_HOST=
COT_TAKSERVER_PORT=8087

# Inbound — receive CoT from an openTAK / TAK Server via TCP streaming.
# Field operator positions appear as tak_client entities on the Vertex map.
# TAK map markers are ingested as Vertex annotations.
COT_RECEIVE_ENABLED=false
COT_RECEIVE_HOST=
COT_RECEIVE_PORT=8087

# ── 5. FRONTEND BUILD ─────────────────────────────────────────────────────────

# Radar overlay layer ID (see MapLibre/RainViewer layer list)
VITE_RADAR_LAYER=RTX-N0B-0
# Fallback radar layer shown at low zoom levels
VITE_RADAR_FALLBACK_LAYER=radar
VITE_RADAR_FALLBACK_MAX_ZOOM=6
# Trail history radius shown on the map (km)
VITE_OBSERVATION_RANGE_KM=50
# Keep false for normal operation. True enables cleaner map snapshots but costs render performance.
VITE_PRESERVE_DRAWING_BUFFER=false

# ── 6. TINYGS (OPTIONAL) ─────────────────────────────────────────────────────
# TinyGS is sunset by default due to upstream API instability/404 responses.
# Set true to opt in and enable the TinyGS poller again.
TINYGS_ENABLED=false

# P25 audio archiving — records per-call audio segments from RadioStream sources.
P25_AUDIO_ENABLED=false
P25_AUDIO_DIR=/data/audio
P25_AUDIO_RETENTION_DAYS=7

# ── 7. AI & ANALYTICS (OPTIONAL) ─────────────────────────────────────────────

# LiteLLM-compatible model (e.g. anthropic/claude-3-haiku, ollama/llama3)
SUMMARY_LLM_MODEL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_API_BASE=

# Anomaly detection — statistical baseline monitoring
ANOMALY_ENABLED=true
ANOMALY_WINDOW_MINUTES=60
ANOMALY_SIGMA_THRESHOLD=2.5

# FlashAlert & TVFR feed fallbacks (RSS/REST URL overrides)
FLASHALERT_ENABLED=false
FLASHALERT_URL=
TVFR_ENABLED=false
TVFR_RSS_URL=

# ── 8. SECURITY ───────────────────────────────────────────────────────────────

# Enable Authentication (Set to true to require login, false allows viewer access only)
AUTH_ENABLED=false
# Secret key for JWT signing (Generate: openssl rand -hex 32)
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=24

# CORS — JSON array of allowed origins (e.g. ["http://192.168.1.100","https://vertex.local"])
CORS_ORIGINS=["http://localhost:3000","http://localhost"]
CORS_ALLOW_CREDENTIALS=false

# TLS — used with: docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# Generate self-signed cert: openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem -out certs/cert.pem -days 365 -nodes -subj "/CN=vertex"
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
