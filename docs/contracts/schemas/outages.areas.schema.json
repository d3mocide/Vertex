{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d3mocide/Vertex/docs/contracts/schemas/outages.areas.schema.json",
  "title": "outages.areas (v0)",
  "description": "Provider-attributed power outage areas, nearby reports, explicit coverage and per-utility totals. Legacy Oregon-specific summary feeds remain compatibility aliases.",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "updated": {
      "type": [
        "string",
        "null"
      ]
    },
    "near": {
      "type": "array",
      "description": "Areas near the region center, nearest first"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Polygon",
                  "MultiPolygon"
                ]
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "utility",
              "meters_out"
            ],
            "properties": {
              "utility": {
                "type": "string"
              },
              "county": {
                "type": "string"
              },
              "meters_out": {
                "type": "integer"
              },
              "meters_served": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tract": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "dist_km": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lat": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lon": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "near_radius_km": {
      "type": "number",
      "minimum": 0
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "utilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "coverage",
          "meters_out",
          "nearby_meters_out"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "meters_out": {
            "type": "integer",
            "minimum": 0
          },
          "nearby_meters_out": {
            "type": "integer",
            "minimum": 0
          },
          "counties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider_id": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    }
  }
}
