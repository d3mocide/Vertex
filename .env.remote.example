# Remote Radio Mode (recommended when OP25/Icecast run on another machine)
# Usage:
#   1) Copy to .env.remote and fill values
#   2) Run Prod: docker compose --env-file .env.remote up -d
#   3) Run Dev: docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.remote up

# Compose should inject the same file into backend/poller
VERTEX_ENV_FILE=.env.remote

# Core DB
POSTGRES_DB=vertex
POSTGRES_USER=vertex
POSTGRES_PASSWORD=changeme

# Frontend
FRONTEND_PORT=80
VITE_STREAM_URL=/stream/op25
RADIO_STREAM_URL=/stream/op25

# Frontend dev proxy targets (remote OP25 + Icecast)
VITE_PROXY_OP25_TARGET=http://192.168.*.*:8080/
VITE_PROXY_ICECAST_TARGET=http://192.168.*.*:8000/

# Poller OP25 source
OP25_HOST=192.168.*.*
OP25_PORT=8080

# Region
REGION_LAT=45.3842
REGION_LON=-122.7635
REGION_ALT=100ft
REGION_NAME=Tualatin Valley
BBOX_MIN_LAT=44.8
BBOX_MAX_LAT=45.9
BBOX_MIN_LON=-123.5
BBOX_MAX_LON=-121.8

# Weather / alerts
NWS_STATION_PRIMARY=KHIO
NWS_STATION_SECONDARY=KUAO
NWS_ZONE=ORZ006
NWS_ALERT_ZONES=ORZ006,ORZ005,ORZ007

# Regional alert feeds 
# Set *_ENABLED=false to disable a source. Override URLs for non-Portland deployments.
FLASHALERT_ENABLED=true
FLASHALERT_URL=http://www.flashalertnewswire.net/IIN/reportsX/flashnews_xml_emergency.php
TVFR_ENABLED=true
TVFR_RSS_URL=https://www.tvfr.com/RSSFeed.aspx?ModID=63&CID=Emergency-Alert-3

# Traffic flow corridors — comma-separated highway name fragments to include.
# Override if deploying outside the Portland/Tualatin metro area.
TRAFFIC_FLOW_CORRIDORS=I-5,99W,Pacific Highway

# AI Situational Summary (optional)
# LiteLLM-compatible model string. Leave SUMMARY_LLM_MODEL blank to disable.
#
# Cloud (requires API key):
#   SUMMARY_LLM_MODEL=anthropic/claude-haiku-4-5-20251001
#   SUMMARY_LLM_API_KEY=sk-ant-...
#
#   SUMMARY_LLM_MODEL=openai/gpt-4o-mini
#   SUMMARY_LLM_API_KEY=sk-...
#
# Local / off-grid (no key needed):
#   SUMMARY_LLM_MODEL=ollama/llama3.2
#   SUMMARY_LLM_API_BASE=http://192.168.1.x:11434
#
SUMMARY_LLM_MODEL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_API_BASE=

# External data API keys (optional)
ODOT_API_KEY=
AIRNOW_API_KEY=
AISSTREAM_API_KEY=

# ADS-B source
ULTRAFEEDER_URL=
ULTRAFEEDER_HOST=
ULTRAFEEDER_PORT=80

# Local AIS-catcher (optional)
AIS_CATCHER_HOST=
AIS_CATCHER_PORT=8100

# MeshCore bridge (optional)
MESHCORE_MODE=network
MESHCORE_HOST=meshcore
MESHCORE_PORT=5000
MESHCORE_BAUD=115200
MESHCORE_BRIDGE_HOST=
MESHCORE_BRIDGE_PORT=7001

# Icecast credentials (only needed if you run local icecast profile)
ICECAST_HOSTNAME=localhost
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_RELAY_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=changeme

# Authentication (optional, disabled by default)
# Set AUTH_ENABLED=true to require login before accessing the dashboard.
# On first load with auth enabled, the UI prompts you to create an admin account.
# Credentials are stored in PostgreSQL (bcrypt hashed) — no env vars needed.
#
# Generate a random secret key:
#   openssl rand -hex 32
AUTH_ENABLED=false
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=24

# Logging 
LOG_LEVEL=INFO
