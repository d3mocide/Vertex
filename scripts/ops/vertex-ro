#!/usr/bin/env bash
# vertex-ro: read-only inspection of a Vertex deployment over SSH, for an agent or a monitoring key.
#
# Installed as /usr/local/bin/vertex-ro (root-owned, copied, never run from the checkout) and reached only through a
# forced command, so the key can do nothing else:
#
#   authorized_keys:  restrict,command="sudo -n /usr/local/bin/vertex-ro" ssh-ed25519 AAAA... vertex-ro
#   sudoers:          Defaults!/usr/local/bin/vertex-ro env_keep += "SSH_ORIGINAL_COMMAND"
#                     <user> ALL=(root) NOPASSWD: /usr/local/bin/vertex-ro
#
# Usage from the client:  ssh <host> <command> [args]     (ssh <host> help lists them)
#
# It runs as root because Docker access is root-equivalent; that is why the commands are a fixed list, arguments are
# validated, nothing is passed to a shell, and every output that could carry configuration is filtered: environment
# values whose names look secret are replaced, URL credentials and key=/token= parameters are masked. Nothing here
# starts, stops, edits or pulls anything.
#
# Optional settings in /etc/default/vertex-ro (root-owned):  VERTEX_DIR=/opt/Vertex   COMPOSE_FILE=docker-compose.yml:...
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8

VERTEX_DIR=/opt/Vertex
COMPOSE_FILE=
if [[ -f /etc/default/vertex-ro && ! -L /etc/default/vertex-ro && $(stat -c %u /etc/default/vertex-ro) == 0 ]]; then
  # shellcheck disable=SC1091
  . /etc/default/vertex-ro
fi
[[ -n $COMPOSE_FILE ]] && export COMPOSE_FILE

die() { echo "vertex-ro: $*" >&2; exit 2; }

# Masks credentials in free text (logs, compose output).
redact() {
  python3 -I -c '
import re, sys
patterns = [
    (re.compile(r"(://[^/\s:@]+:)[^@\s/]+@"), r"\1***@"),
    (re.compile(r"(?i)(\b(?:api[_-]?key|apikey|access[_-]?key|token|secret|password|passwd|pwd|auth|signature|sig|key|client[_-]?secret)\s*[=:]\s*[\"\x27]?)[^&\s\"\x27,;}]+"), r"\1***"),
    (re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+"), r"\1***"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S), "***PRIVATE KEY***"),
]
text = sys.stdin.read()
for rx, repl in patterns:
    text = rx.sub(repl, text)
sys.stdout.write(text)
'
}

compose() { (cd "$VERTEX_DIR" && docker compose "$@"); }

# git as the checkout's owner and without optional locks: a plain `git status` run as root refreshes .git/index and
# leaves it owned by root, which then breaks every git step the owner (and vertex-deploy) runs.
git_ro() {
  local owner
  owner=$(stat -c %U "$VERTEX_DIR")
  if [[ $EUID -eq 0 && $owner != root ]]; then
    runuser -u "$owner" -- env HOME="$(getent passwd "$owner" | cut -d: -f6)" GIT_OPTIONAL_LOCKS=0 git -c safe.directory="$VERTEX_DIR" -C "$VERTEX_DIR" "$@"
  else
    GIT_OPTIONAL_LOCKS=0 git -c safe.directory="$VERTEX_DIR" -C "$VERTEX_DIR" "$@"
  fi
}

services() { compose config --services 2>/dev/null; }

valid_service() {
  local s=$1
  [[ $s =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || return 1
  services | grep -qxF -- "$s"
}

valid_lines() { [[ $1 =~ ^[0-9]{1,4}$ ]] && (( $1 >= 1 && $1 <= 5000 )); }

cmd_help() {
  cat <<'EOF'
vertex-ro commands (all read-only):
  status              containers, health, uptime and the commit each image was built from
  stats               CPU, memory, network and disk I/O per container (one sample)
  logs <svc> [N]      last N log lines of one service (default 200, max 5000), credentials masked
  errors [N]          lines that look like errors or warnings across all services, last N per service (default 500)
  config              effective docker compose config with secret values replaced
  env-keys            the names set in .env (no values)
  git                 checkout commit, branch, local changes, and how it compares with origin (as of last fetch)
  images              Vertex images on the host with their tags, size and source commit
  health              backend /health through the frontend's published port
  disk                what uses space: the checkout (tracked vs ignored), Docker images, volumes and build cache
  deploys             the vertex-deploy history (time, from, to, result, who)
  top                 processes inside each container with their CPU and memory
  redis               Redis load: commands, memory, biggest keys, and a 5 s traffic sample by client and key pattern
  db                  Postgres: table sizes, write activity per table, connections, slowest statements (if tracked)
  profile <svc> [s]   sample a Python service's CPU with py-spy for s seconds (10-120, default 30) and summarise it
  host                load, memory, disk, Docker disk use, kernel and uptime
  report              status + stats + git + host + health in one go
EOF
}

cmd_status() {
  compose ps --all --format 'table {{.Service}}\t{{.State}}\t{{.Status}}\t{{.Image}}'
  echo
  printf '%-15s %-12s %s\n' SERVICE REVISION CREATED
  local id svc image rev created
  for id in $(compose ps -q); do
    svc=$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.service" }}' "$id")
    image=$(docker inspect -f '{{ .Image }}' "$id")
    rev=$(docker image inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image")
    created=$(docker image inspect -f '{{ .Created }}' "$image")
    rev=${rev:-(local)}
    printf '%-15s %-12s %s\n' "$svc" "${rev:0:12}" "$created"
  done
}

cmd_stats() {
  docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}\t{{.PIDs}}'
}

cmd_logs() {
  local svc=${1:-} n=${2:-200}
  [[ -n $svc ]] || die "usage: logs <service> [lines]"
  valid_service "$svc" || die "unknown service: $svc (services: $(services | tr '\n' ' '))"
  valid_lines "$n" || die "lines must be 1-5000"
  compose logs --no-color --timestamps --tail "$n" "$svc" 2>&1 | redact
}

cmd_errors() {
  local n=${1:-500} svc
  valid_lines "$n" || die "lines must be 1-5000"
  for svc in $(services); do
    compose logs --no-color --timestamps --tail "$n" "$svc" 2>&1 \
      | grep -E -i '\b(error|exception|traceback|critical|fatal|warn(ing)?|oom|killed|refused|timeout|timed out)\b' \
      | tail -n 50 | redact || true
  done
}

cmd_config() {
  compose config --format json | python3 -I -c '
import json, re, sys
secret_name = re.compile(r"(?i)(pass|secret|token|key|credential|auth|private|salt|cookie|session|dsn|cert)")
# Names that match the pattern above but hold no secret (an allowlist of hosts, a switch, a limit).
not_secret = re.compile(r"(?i)^(ALLOW_PRIVATE_IPS|PRIVATE_HOST_ALLOWLIST|.*_MAX_TOKENS|.*_TOKEN_EXPIRE_.*|TLS_(CERT|KEY)_PATH)$")
# On/off switches are shown even under a secret-looking name; numbers are not (a passcode or PIN is a number).
plain = re.compile(r"(?i)^(true|false|yes|no|on|off)$")
cred_url = re.compile(r"(://[^/\s:@]+:)[^@\s/]+@")
def clean(name, value):
    if not isinstance(value, str):
        return value
    if secret_name.search(name or "") and not not_secret.match(name or "") and not plain.match(value):
        return "***" if value else value
    return cred_url.sub(r"\1***@", value)
def walk(node, name=None):
    if isinstance(node, dict):
        return {k: walk(v, k) for k, v in node.items()}
    if isinstance(node, list):
        return [walk(v, name) for v in node]
    return clean(name, node)
cfg = json.load(sys.stdin)
for svc in cfg.get("services", {}).values():
    env = svc.get("environment") or {}
    svc["environment"] = {k: clean(k, v) for k, v in env.items()}
    for key in ("healthcheck", "command", "entrypoint"):
        if key in svc:
            svc[key] = walk(svc[key])
cfg.pop("secrets", None)
json.dump(cfg, sys.stdout, indent=2, sort_keys=True)
print()
' | redact
}

cmd_env_keys() {
  [[ -f $VERTEX_DIR/.env ]] || die "no .env in $VERTEX_DIR"
  grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$VERTEX_DIR/.env" \
    | sed -E 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/' | sort
  echo
  stat -c '.env  mode %a  owner %U:%G' "$VERTEX_DIR/.env"
}

cmd_git() {
  local g=(git_ro)
  "${g[@]}" log -1 --format='commit %H%nshort  %h%ndate   %cI%nsubject %s'
  "${g[@]}" status --short --branch | redact
  local upstream
  if upstream=$("${g[@]}" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
    echo "vs $upstream (as of last fetch): $("${g[@]}" rev-list --left-right --count HEAD..."$upstream" | awk '{print $1 " ahead, " $2 " behind"}')"
    stat -c 'last fetch: %y' "$VERTEX_DIR/.git/FETCH_HEAD" 2>/dev/null || echo "last fetch: never"
  fi
}

cmd_images() {
  docker image ls --format '{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.Size}}\t{{.CreatedSince}}' | grep -i vertex | while IFS=$'\t' read -r ref id size age; do
    printf '%-60s %-14s %-9s %-16s %s\n' "$ref" "$id" "$size" "$age" \
      "$(docker image inspect -f '{{ with index .Config.Labels "org.opencontainers.image.revision" }}{{ . }}{{ else }}(local build){{ end }}' "$id" | cut -c1-12)"
  done
}

cmd_health() {
  local port
  port=$(compose port frontend 8080 2>/dev/null | head -1) || true
  [[ -n $port ]] || die "frontend has no published port"
  port=${port/0.0.0.0/127.0.0.1}
  port=${port/\[::\]/127.0.0.1}
  curl -fsS -m 10 -w '\nHTTP %{http_code} in %{time_total}s\n' "http://$port/health" | redact
}

cmd_host() {
  echo "host: $(uname -srm)   up $(uptime -p)"
  echo "load: $(cut -d' ' -f1-3 /proc/loadavg)   cpus: $(nproc)"
  echo
  free -h
  echo
  df -h -x tmpfs -x devtmpfs -x overlay -x squashfs 2>/dev/null
  echo
  docker system df
  echo
  echo "failed units:"; systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/  /' || true
  echo
  echo "kernel OOM kills (this boot):"; journalctl -k -b --no-pager -q 2>/dev/null | grep -i 'killed process' | tail -n 10 | sed 's/^/  /' || true
}

cmd_disk() {
  df -h "$VERTEX_DIR" /var/lib/docker 2>/dev/null | awk 'NR == 1 || !seen[$1]++'
  echo
  echo "checkout $VERTEX_DIR: $(du -sh "$VERTEX_DIR" 2>/dev/null | cut -f1) total"
  du -xh --max-depth=1 "$VERTEX_DIR" 2>/dev/null | sort -rh | head -n 15 | sed 's/^/  /'
  echo
  echo "untracked or ignored in the checkout (largest first; .env and config are expected):"
  git_ro status --porcelain --ignored --untracked-files=normal \
    | sed -n 's/^\(!!\|??\) //p' | while read -r p; do du -sh "$VERTEX_DIR/$p" 2>/dev/null; done | sort -rh | head -n 25 | sed 's/^/  /'
  echo
  docker system df -v | redact
}

cmd_top() {
  local id name
  for id in $(compose ps -q); do
    name=$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.service" }}' "$id")
    echo "== $name"
    docker top "$id" -eo pid,pcpu,pmem,rss,etime,args 2>/dev/null | cut -c1-160 | redact
  done
}

# redis-cli inside the redis container, authenticated with the container's own REDIS_PASSWORD.
rcli() {
  # shellcheck disable=SC2016  # expanded inside the container, from its own environment
  compose exec -T redis sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" exec redis-cli "$@"' redis-cli "$@"
}

cmd_redis() {
  echo "== top commands by total time"
  rcli INFO commandstats | python3 -I -c '
import re, sys
rows = []
for line in sys.stdin:
    m = re.match(r"cmdstat_(\S+?):calls=(\d+),usec=(\d+),usec_per_call=([\d.]+)", line)
    if m: rows.append((int(m[3]), m[1], int(m[2]), float(m[4])))
total = sum(r[0] for r in rows) or 1
print("%-16s%14s%10s%8s%10s" % ("command", "calls", "total s", "share", "us/call"))
for usec, cmd, calls, per in sorted(rows, reverse=True)[:15]:
    print(f"{cmd:<16}{calls:>14,}{usec/1e6:>10.0f}{usec/total:>8.0%}{per:>10.1f}")'
  echo
  echo "== stats"
  rcli INFO stats | grep -E '^(total_connections_received|total_commands_processed|instantaneous_ops_per_sec|total_net_input_bytes|total_net_output_bytes|instantaneous_input_kbps|instantaneous_output_kbps|pubsub_channels|expired_keys|evicted_keys|keyspace_hits|keyspace_misses)' | tr -d '\r'
  rcli INFO memory | grep -E '^(used_memory_human|used_memory_peak_human|maxmemory_human|maxmemory_policy|mem_fragmentation_ratio)' | tr -d '\r'
  rcli INFO keyspace | tr -d '\r' | grep -v '^#'
  echo
  echo "== 5 s traffic sample (sizes and counts only; ids in key names replaced)"
  local ips readkeys
  readkeys=$(mktemp)
  ips=$(for id in $(compose ps -q); do docker inspect -f '{{ index .Config.Labels "com.docker.compose.service" }}{{ range .NetworkSettings.Networks }} {{ .IPAddress }}{{ end }}' "$id"; done)
  # shellcheck disable=SC2016  # expanded inside the container, from its own environment
  { compose exec -T redis sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" timeout 5 redis-cli MONITOR' 2>/dev/null || true; } \
    | IPS="$ips" READKEYS="$readkeys" python3 -I -c '
import os, re, sys
from collections import defaultdict
svc = {}
for line in os.environ["IPS"].splitlines():
    parts = line.split()
    for ip in parts[1:]: svc[ip] = parts[0]
arg = re.compile(r"\"((?:[^\"\\\\]|\\\\.)*)\"")
def size(s):
    return len(re.sub(r"\\\\x[0-9a-fA-F]{2}|\\\\.", "x", s))
def pattern(k):
    k = re.sub(r"[0-9a-fA-F]{8,}", "<id>", k)
    k = re.sub(r"\d+(\.\d+)?", "<n>", k)
    return k[:70]
stats = defaultdict(lambda: [0, 0])
keys_read = defaultdict(int)
sample_key = {}
lines = 0
for line in sys.stdin:
    m = re.match(r"[\d.]+ \[\d+ ([\d.]+):\d+\] (.*)", line)
    if not m: continue
    lines += 1
    args = arg.findall(m[2])
    if not args: continue
    cmd = args[0].upper()
    key = args[1] if len(args) > 1 else ""
    who = svc.get(m[1], m[1])
    s = stats[(who, cmd, pattern(key))]
    s[0] += 1
    s[1] += sum(size(a) for a in args[2:])
    if cmd in ("GET", "HGETALL", "SMEMBERS", "LRANGE", "MGET", "HGET", "ZRANGE", "ZRANGEBYSCORE", "XRANGE"):
        keys_read[pattern(key)] += 1
        sample_key.setdefault(pattern(key), key)
print(f"{lines} commands in 5 s")
print("%-14s%-14s%7s%12s  %s" % ("client", "command", "count", "bytes sent", "key pattern"))
for (who, cmd, k), (n, b) in sorted(stats.items(), key=lambda x: (-x[1][1], -x[1][0]))[:30]:
    print(f"{who:<14}{cmd:<14}{n:>7}{b:>12,}  {k}")
print()
with open(os.environ["READKEYS"], "w") as f:
    for k, n in sorted(keys_read.items(), key=lambda x: -x[1])[:12]:
        f.write("%d\t%s\t%s\n" % (n, k, sample_key[k]))'
  echo
  echo "== estimated read volume (reads in the sample x current size of one key of that pattern)"
  printf '%8s %12s %14s  %s\n' reads "key bytes" "bytes/5 s" "key pattern"
  local n pat key bytes
  while IFS=$'\t' read -r n pat key; do
    bytes=$(rcli MEMORY USAGE "$key" SAMPLES 0 2>/dev/null | tr -d '\r')
    [[ $bytes =~ ^[0-9]+$ ]] || bytes=0
    printf '%8d %12d %14d  %s\n' "$n" "$bytes" $((n * bytes)) "$pat"
  done < "$readkeys" | sort -k3 -rn
  rm -f "$readkeys"
  echo
  echo "== biggest keys"
  rcli --bigkeys -i 0.01 2>/dev/null | tr -d '\r' | grep -E '^(Biggest|-------- summary|[0-9]+ (keys|strings|hashs|hashes|lists|sets|zsets|streams))' \
    | sed -E 's/"([^"]*)"/"\1"/' | python3 -I -c '
import re, sys
for line in sys.stdin:
    line = re.sub(r"[0-9a-fA-F]{8,}", "<id>", line.rstrip())
    print(line)'
}

# psql inside the db container as the app user. Fixed read-only queries; statement text (if pg_stat_statements is on)
# is already normalised by Postgres (literals become $1).
psql_() {
  # shellcheck disable=SC2016  # expanded inside the container, from its own environment
  compose exec -T db sh -c 'exec psql -X -q -P pager=off -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "$1"' psql "$1"
}

cmd_db() {
  echo "== largest tables"
  psql_ "SELECT relname AS table, pg_size_pretty(pg_total_relation_size(relid)) AS total, pg_size_pretty(pg_relation_size(relid)) AS heap, n_live_tup AS rows FROM pg_stat_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 15"
  echo "== write activity since stats reset"
  psql_ "SELECT relname AS table, n_tup_ins AS inserts, n_tup_upd AS updates, n_tup_hot_upd AS hot_upd, n_tup_del AS deletes, n_dead_tup AS dead, seq_scan, idx_scan, last_autovacuum::timestamp(0) AS autovacuum FROM pg_stat_user_tables ORDER BY n_tup_ins + n_tup_upd + n_tup_del DESC LIMIT 15"
  echo "== database"
  psql_ "SELECT pg_size_pretty(pg_database_size(current_database())) AS size, xact_commit AS commits, blks_read, blks_hit, tup_inserted, tup_updated, tup_deleted, temp_bytes, stats_reset::timestamp(0) FROM pg_stat_database WHERE datname = current_database()"
  psql_ "SELECT name, setting, unit FROM pg_settings WHERE name IN ('shared_buffers','work_mem','wal_level','max_wal_size','checkpoint_timeout','synchronous_commit','autovacuum','wal_compression')"
  echo "== connections"
  psql_ "SELECT coalesce(nullif(application_name, ''), '(none)') AS app, state, count(*) FROM pg_stat_activity WHERE datname = current_database() GROUP BY 1, 2 ORDER BY 3 DESC"
  echo "== slowest statements (pg_stat_statements)"
  psql_ "SELECT calls, round(total_exec_time)::bigint AS total_ms, round(mean_exec_time::numeric, 2) AS mean_ms, rows, left(regexp_replace(query, '\s+', ' ', 'g'), 110) AS query FROM pg_stat_statements ORDER BY total_exec_time DESC LIMIT 15" 2>/dev/null \
    || echo "(pg_stat_statements is not enabled)"
}

# py-spy runs in a throwaway container from the service's own image, sharing only its PID namespace, with ptrace. The
# wheel is pinned by version and sha256 (both architectures), so nothing unverified ever attaches to a production process.
PYSPY_REQ='py-spy==0.4.1 \
  --hash=sha256:6a80ec05eb8a6883863a367c6a4d4f2d57de68466f7956b6367d4edd5c61bb29 \
  --hash=sha256:ee776b9d512a011d1ad3907ed53ae32ce2f3d9ff3e1782236554e22103b5c084'

cmd_profile() {
  local svc=${1:-} secs=${2:-30} id image
  [[ -n $svc ]] || die "usage: profile <service> [seconds]"
  valid_service "$svc" || die "unknown service: $svc"
  if ! [[ $secs =~ ^[0-9]{2,3}$ ]] || (( secs < 10 || secs > 120 )); then die "seconds must be 10-120"; fi
  id=$(compose ps -q "$svc" | head -n 1)
  [[ -n $id ]] || die "$svc is not running"
  image=$(docker inspect -f '{{ .Image }}' "$id")
  docker run --rm --pid="container:$id" --cap-add SYS_PTRACE --entrypoint sh --user 0 \
    -e PYSPY_REQ="$PYSPY_REQ" -e SECS="$secs" "$image" -c '
      set -e
      printf "%s\n" "$PYSPY_REQ" > /tmp/req.txt
      pip install -q --no-cache-dir --disable-pip-version-check --root-user-action=ignore --require-hashes \
        --only-binary :all: --target /tmp/pyspy -r /tmp/req.txt >/dev/null 2>&1 || { echo "py-spy install failed" >&2; exit 3; }
      /tmp/pyspy/bin/py-spy record --pid 1 --subprocesses --duration "$SECS" --rate 50 --nonblocking \
        --format raw --output /tmp/profile.txt >/dev/null 2>&1 || { echo "py-spy record failed" >&2; exit 4; }
      cat /tmp/profile.txt' \
  | SECS="$secs" python3 -I -c '
import collections, os, re, sys
secs = int(os.environ["SECS"]); rate = 50
per_proc = collections.Counter(); incl = collections.defaultdict(collections.Counter); self_ = collections.defaultdict(collections.Counter)
def frame(f):
    m = re.match(r"(.*?) \((?:/app/|/usr/local/lib/python3\.\d+/(?:site-packages/)?)?([^:)]*)(?::\d+)?\)", f)
    return f"{m[1]} ({m[2]})" if m else f
for line in sys.stdin:
    line = line.rstrip()
    if not line or " " not in line: continue
    stack, n = line.rsplit(" ", 1)
    try: n = int(n)
    except ValueError: continue
    parts = stack.split(";")
    # With --subprocesses each process appears as a "process N:<cmdline>" frame under its parent; label the samples
    # with the innermost one.
    marks = [i for i, f in enumerate(parts) if re.match(r"process \d+:", f)]
    if marks:
        proc = re.sub(r"^process \d+:", "", parts[marks[-1]]).strip("\"").strip()
        proc = re.sub(r"from multiprocessing\.(\w+) import .*", r"multiprocessing \1 worker", proc)[:70]
        frames = [frame(f) for f in parts[marks[-1] + 1:] if f]
    else:
        proc, frames = "?", [frame(f) for f in parts if f]
    per_proc[proc] += n
    for f in set(frames): incl[proc][f] += n
    if frames: self_[proc][frames[-1]] += n
def pct(n): return f"{n / rate / secs * 100:5.1f}%"
if not per_proc:
    print("no samples: py-spy could not attach (is this a Python service?)"); sys.exit(1)
print(f"CPU over {secs} s, as % of one core (sampled at {rate} Hz):")
for proc, n in per_proc.most_common():
    print(f"\n== {pct(n)}  {proc}")
    print("   inclusive (time in this function and what it calls):")
    shown = 0
    for f, c in incl[proc].most_common():
        if f.startswith(("<module>", "run (asyncio", "run_forever", "_run_once", "_run (asyncio", "run_until_complete")): continue
        print(f"   {pct(c)}  {f[:110]}"); shown += 1
        if shown >= 20: break
    print("   self (time in the function itself):")
    for f, c in self_[proc].most_common(10): print(f"   {pct(c)}  {f[:110]}")
'
}

cmd_deploys() {
  if [[ -f /var/lib/vertex-deploy/history ]]; then tail -n 30 /var/lib/vertex-deploy/history; else echo "no deploys yet"; fi
}

cmd_report() {
  for section in status stats git host health; do
    echo "===== $section ====="
    ( "cmd_$section" ) || echo "($section failed)"
    echo
  done
}

[[ -d $VERTEX_DIR ]] || die "VERTEX_DIR $VERTEX_DIR does not exist"

# The forced command passes the client's request in SSH_ORIGINAL_COMMAND; plain words only, split on whitespace.
request=${SSH_ORIGINAL_COMMAND:-${*:-help}}
[[ $request =~ ^[A-Za-z0-9\ _.-]*$ ]] || die "unsupported characters in request"
read -r -a argv <<< "$request"
command=${argv[0]:-help}
args=("${argv[@]:1}")

case $command in
  help|-h|--help) cmd_help ;;
  status)   cmd_status ;;
  stats)    cmd_stats ;;
  logs)     cmd_logs "${args[@]}" ;;
  errors)   cmd_errors "${args[@]}" ;;
  config)   cmd_config ;;
  env-keys) cmd_env_keys ;;
  git)      cmd_git ;;
  images)   cmd_images ;;
  health)   cmd_health ;;
  host)     cmd_host ;;
  disk)     cmd_disk ;;
  deploys)  cmd_deploys ;;
  top)      cmd_top ;;
  redis)    cmd_redis ;;
  db)       cmd_db ;;
  profile)  cmd_profile "${args[@]}" ;;
  report)   cmd_report ;;
  *) die "unknown command '$command' (try: help)" ;;
esac
